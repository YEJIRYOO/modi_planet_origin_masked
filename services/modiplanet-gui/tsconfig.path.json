{
  "include": ["src"],
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/components/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@services/*": ["./src/services/*"]
    }
  }
}
